{
  "name": "apex-launcher",
  "productName": "Apex Launcher",
  "version": "1.0.10",
  "description": "Launcher Minecraft moderne — ApexDevlabs",
  "author": "ApexDevlabs",
  "license": "MIT",
  "private": true,
  "main": "dist-main/electron/main.js",
  "type": "module",
  "scripts": {
    "install:deps": "npm install",
    "dev:renderer": "vite",
    "dev:main": "tsc -p tsconfig.main.json --watch",
    "dev:electron": "wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron ./dist-main/electron/main.js",
    "dev": "concurrently -k \"npm run dev:renderer\" \"npm run dev:main\" \"npm run dev:electron\"",
    "typecheck": "tsc --noEmit -p tsconfig.renderer.json && tsc --noEmit -p tsconfig.main.json && tsc --noEmit -p tsconfig.preload.json",
    "test": "vitest run",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json && tsc -p tsconfig.preload.json",
    "build": "npm run sync-version && npm run build:renderer && npm run build:main && node scripts/generate-icon.mjs",
    "sync-version": "node scripts/sync-version.mjs",
    "bump": "node scripts/bump.mjs",
    "dist": "electron-builder --dir",
    "verify": "node scripts/verify-build.mjs",
    "installer": "powershell -ExecutionPolicy Bypass -File scripts/build-installer.ps1",
    "postinstall": "node scripts/generate-icon.mjs"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "unzipper": "^0.12.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^34.3.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^2.1.9",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.apexdevlabs.launcher",
    "productName": "Apex Launcher",
    "copyright": "Copyright © 2026 ApexDevlabs",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist-main/**/*",
      "dist-renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "dir"
      ],
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "signAndEditExecutable": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.games",
      "darkModeSupport": true
    },
    "dmg": {
      "icon": "assets/icon.icns"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icons",
      "category": "Game",
      "maintainer": "ApexDevlabs",
      "description": "Modern Minecraft Java Edition launcher by ApexDevlabs."
    }
  },
  "allowScripts": {
    "electron@34.5.8": true,
    "esbuild@0.25.12": true,
    "esbuild@0.21.5": true
  }
}
