# Clés API et configuration locale (NE PAS VERSIONNER de vrais secrets)
# Copier ce fichier vers .env et remplir les valeurs nécessaires.

# CurseForge : clé API obligatoire pour utiliser le catalogue CurseForge.
# Obtenez-la sur https://console.curseforge.com/ puis collez-la ici ou
# dans Paramètres > Contenu > Clé API CurseForge.
CURSEFORGE_API_KEY=

# Microsoft / Azure : client ID de l'application Azure pour la connexion Microsoft.
# Créez une application sur https://portal.azure.com (comptes personnels pris en charge,
# URI de redirection http://localhost). Collez le client ID ici ou dans Paramètres > Comptes.
# Sans client ID configuré, la connexion Microsoft est désactivée avec un message explicatif.
MICROSOFT_CLIENT_ID=

# Dossier de données personnalisé (optionnel, sinon %APPDATA%/ApexLauncher)
APEX_DATA_DIR=
